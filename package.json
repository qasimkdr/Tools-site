{
  "name": "solvepilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-static-build.mjs && next build && node scripts/validate-content.mjs && node scripts/verify-related-navigation.cjs --export --report && node scripts/check-navigation-graph.mjs --report && node scripts/indexnow.mjs generate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "context:report": "node scripts/context-report.mjs",
    "verify:roadmap106": "node scripts/verify-roadmap-106-125.cjs",
    "verify:calculate": "node scripts/verify-calculate-interaction.cjs",
    "verify:roadmap126": "node scripts/verify-roadmap-126-145.cjs",
    "verify:roadmap146": "node scripts/verify-roadmap-146-165.cjs",
    "verify:roadmap166": "node scripts/verify-roadmap-166-185.cjs",
    "verify:redaction": "node scripts/verify-redacted-text-interaction.cjs",
    "verify:roadmap186": "node scripts/verify-roadmap-186-205.cjs",
    "verify:roadmap206": "node scripts/verify-roadmap-206-225.cjs",
    "verify:sphere": "node scripts/verify-sphere-interaction.cjs",
    "verify:next20": "node scripts/verify-next20.cjs && node scripts/verify-boolean-interaction.cjs",
    "verify:roadmap268": "node scripts/verify-roadmap-268-plus.cjs",
    "indexnow:notify": "node scripts/indexnow.mjs notify",
    "verify:indexnow": "node --test scripts/indexnow.test.mjs",
    "verify:related": "node scripts/verify-related-navigation.cjs",
    "related:report": "node scripts/verify-related-navigation.cjs --report",
    "verify:navigation": "node --test scripts/navigation-graph.test.mjs && node scripts/check-navigation-graph.mjs",
    "verify:roadmap328": "node scripts/verify-roadmap-328-plus.cjs",
    "verify:roadmap369": "node scripts/verify-roadmap-369-plus.cjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.7.2"
  }
}
